{
  "name": "sigurd-startup",
  "private": false,
  "version": "4.11.2",
  "type": "module",
  "description": "A web component game about Sigurd's startup journey",
  "main": "dist/sigurd-startup.umd.js",
  "module": "dist/sigurd-startup.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sigurd-startup.es.js",
      "require": "./dist/sigurd-startup.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/sigurd-startup.css": "./dist/sigurd-startup.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasandersen/sigurd-startup-game.git"
  },
  "keywords": [
    "game",
    "web-component",
    "react",
    "startup",
    "sigurd"
  ],
  "author": "Jonas Andersen",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/version.js build && vite build",
    "build:dev": "node scripts/version.js build && vite build --mode development",
    "build:patch": "node scripts/version.js patch && vite build",
    "build:minor": "node scripts/version.js minor && vite build",
    "build:major": "node scripts/version.js major && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:package": "npm run build:lib && npm run test:package",
    "test:package": "node scripts/test-package.js",
    "prepublishOnly": "npm run build:package",
    "publish:npm": "npm run build:package && npm publish",
    "version:build": "node scripts/version.js build",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.85.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "pathfinding": "^0.4.18",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.19.17",
    "@types/pathfinding": "^0.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5"
  }
}
